# ---------------------------------------------------------------------------
# Public — safe to commit. These live in .env and ship to the browser.
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ---------------------------------------------------------------------------
# Secret — never commit. Put these in .env.local for local development, and in
# your host's secret store for production.
# ---------------------------------------------------------------------------

# Encrypts the /admin session cookie. Minimum 32 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# The passcode restaurant managers type on /admin.
ADMIN_PASSCODE=""

# Supabase service-role key — bypasses RLS, used only by server functions for
# admin writes. Supabase dashboard → Project Settings → API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# Telegram alerts for new bookings. Leave both blank to turn them off — the
# booking still saves, it just goes unannounced, and /admin says so.
#
#   1. Message @BotFather on Telegram, send /newbot, and copy the token.
#   2. Create the group the staff will read, and add the bot to it.
#   3. Send any message in that group, then open
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#      and copy "chat":{"id": … } — group ids are negative, e.g. -1001234567890.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional. Absolute site origin, used for canonical URLs and sitemap.xml.
VITE_SITE_URL="https://graciafamily.uz"
